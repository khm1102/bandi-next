# 복사해서 .env 로 사용한다 (cp .env.example .env). 실제 비밀값은 커밋하지 않는다.
DATABASE_URL=postgres://bandi:bandi1234@localhost:5433/bandi
TEST_DATABASE_URL=postgres://bandi:bandi1234@localhost:5433/bandi_test

# 파일 저장 루트 (private/, public/ 하위에 저장). 로컬 영구 볼륨만 사용한다.
FILE_STORAGE_ROOT=/tmp/bandi-next-files
FILE_STORAGE_MAX_UPLOAD_BYTES=524288000

# 학교 포털 로그인 실패 제한용 HMAC 비밀값 (prod 필수, 16자 이상)
LOGIN_ATTEMPT_HASH_SECRET=local-development-only-secret
SCHOOL_LOGIN_MAX_FAILURES=5
SCHOOL_LOGIN_FAILURE_WINDOW_MINUTES=15
SCHOOL_LOGIN_COOLDOWN_MINUTES=15

# 세션
SESSION_TTL_MINUTES=30

# 리버스 프록시(nginx 등) 뒤에서만 true. 속도 제한의 클라이언트 IP를 X-Forwarded-For에서 읽는다.
TRUST_PROXY=false

# 학교 SSO. real=실제 학교 포털, fake=로컬·E2E 전용 가짜(운영 금지)
SCHOOL_SSO_MODE=real
